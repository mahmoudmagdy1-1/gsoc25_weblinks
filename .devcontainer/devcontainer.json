{
	"name": "Joomla Weblinks (Docker Compose)",
	// Use docker-compose.yml to define the services.
	"dockerComposeFile": "docker-compose.yml",
	
	// The service to open a terminal in.
	"service": "app",
	
	// The folder to open in the VS Code editor.
	"workspaceFolder": "/workspaces/weblinks",

	// Forward the ports from the services to your local machine.
	"forwardPorts": [
		80,   // Joomla app
		8081, // phpMyAdmin
		3306  // MySQL database
	],
	"portsAttributes": {
		"80": {
			"label": "Joomla (Web Server)",
			"onAutoForward": "openBrowser"
		},
		"8081": {
			"label": "phpMyAdmin"
		}
	},

	// Run our custom script after the containers are created and running.
	"postCreateCommand": "bash ./.devcontainer/post-create.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"xdebug.php-debug",
				"bmewburn.vscode-intelephense-client",
				"esbenp.prettier-vscode"
			]
		}
	},

	// We will connect to the 'app' container as the root user.
	"remoteUser": "root"
}
